{
  "name": "departmentms-backend",
  "version": "1.0.0",
  "description": "",
  "main": "src/index.js",
  "scripts": {
    "test": "jest --coverage --silent",
    "dev": "npx nodemon src/app.ts",
    "start": "node dist/app.js",
    "build": "tsc",
    "create-admin": "ts-node src/utils/createAdmin.ts",
    "seed-db": "ts-node src/utils/seedDatabase.ts",
    "clear-db": "ts-node src/utils/clearDatabase.ts",
    "assign-students": "ts-node src/utils/assignStudentsToCourses.ts",
    "update-schema": "ts-node src/utils/updateCourseSchema.ts",
    "lint": "eslint src tests",
    "start:prod": "node dist/app.js",
    "lint:security": "eslint src --quiet"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.10.1",
    "multer": "^1.4.5-lts.1",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/multer": "^1.4.12",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.39.5",
    "eslint-plugin-security": "^4.2.0",
    "globals": "^17.13.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.71.1"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/tests"
    ],
    "setupFiles": [
      "<rootDir>/tests/setup.ts"
    ],
    "transform": {
      "^.+.ts$": [
        "ts-jest",
        {
          "diagnostics": false
        }
      ]
    },
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/@types/**",
      "!src/utils/createAdmin.ts",
      "!src/utils/seedDatabase.ts",
      "!src/utils/clearDatabase.ts",
      "!src/utils/assignStudentsToCourses.ts",
      "!src/utils/updateCourseSchema.ts"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 85,
        "lines": 85,
        "functions": 85,
        "branches": 70
      }
    },
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup-mocks.ts"
    ],
    "resetMocks": true
  }
}
