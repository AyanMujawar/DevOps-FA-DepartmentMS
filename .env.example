# Copy to .env for local use:   cp .env.example .env
# On the server, Ansible generates the real .env from GitHub Secrets. Never commit a real .env.

# Signs login tokens. Must be a long random value (the backend refuses weak ones in production).
JWT_SECRET=local-development-signing-key-change-me

# Where the browser reaches the site (used for the CORS allow-list)
FRONTEND_URL=http://localhost

# Which images to run (CI sets IMAGE_TAG to the git commit SHA)
REGISTRY=ghcr.io/nehal-kongwad
IMAGE_TAG=latest

# Monitoring stack
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
